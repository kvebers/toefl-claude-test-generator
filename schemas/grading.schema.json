{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toefl-grading.schema.json",
  "title": "Claude grading output (results/<attempt>/grading.json)",
  "type": "object",
  "required": ["tasks", "overall"],
  "properties": {
    "tasks": {
      "type": "object",
      "description": "Keyed by task id. Required for every email, academic_discussion and interview task in grading_input.json.",
      "additionalProperties": { "$ref": "#/$defs/taskGrade" }
    },
    "objective_patterns": { "type": "string", "description": "What the reading/listening/build-sentence misses have in common." },
    "overall": {
      "type": "object",
      "required": ["summary", "strengths", "priorities"],
      "properties": {
        "summary": { "type": "string" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "priorities": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "required": ["title", "why", "how", "tags"],
            "properties": {
              "title": { "type": "string" },
              "why": { "type": "string" },
              "how": { "type": "array", "items": { "type": "string" } },
              "tags": { "type": "array", "items": { "type": "string" } },
              "practice_command": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["tag", "quote", "correction", "explanation"],
      "properties": {
        "tag": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_.]+$" },
        "quote": { "type": "string" },
        "correction": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "taskGrade": {
      "type": "object",
      "required": ["score", "summary", "errors"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "criteria": {
          "type": "array",
          "description": "One entry per criterion in criteria_to_rate (goals from spec/toefl-2026.yaml).",
          "items": {
            "type": "object", "required": ["id", "status", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["met", "partly", "not_met"] },
              "evidence": { "type": "string" },
              "improve": { "type": "string", "description": "Required unless met: concrete advice for this learner." },
              "example": { "type": "string", "description": "Required unless met: the learner's own sentence rewritten to meet the criterion." }
            }
          }
        },
        "dimensions": { "type": "object", "additionalProperties": { "type": "string" } },
        "summary": { "type": "string" },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "improved_version": { "type": "string" },
        "questions": {
          "type": "object",
          "description": "Interview only: per-question grades keyed by question id.",
          "additionalProperties": {
            "type": "object",
            "required": ["score", "summary"],
            "properties": {
              "score": { "type": "number", "minimum": 0, "maximum": 5 },
              "summary": { "type": "string" },
              "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
              "model_answer": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

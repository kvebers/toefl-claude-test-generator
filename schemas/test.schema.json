{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toefl-test.schema.json",
  "title": "TOEFL practice test",
  "type": "object",
  "required": ["id", "title", "format", "mode", "created", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "title": { "type": "string" },
    "format": { "const": "toefl-ibt-2026" },
    "mode": { "enum": ["full", "practice"] },
    "created": { "type": "string" },
    "author": { "type": "string" },
    "difficulty": { "enum": ["easy", "medium", "hard", "mixed"] },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "modules"],
      "additionalProperties": false,
      "properties": {
        "id": { "enum": ["reading", "listening", "writing", "speaking"] },
        "modules": {
          "type": "object",
          "required": ["m1"],
          "additionalProperties": false,
          "properties": {
            "m1": { "$ref": "#/$defs/module" },
            "m2_easy": { "$ref": "#/$defs/module" },
            "m2_hard": { "$ref": "#/$defs/module" }
          },
          "dependentRequired": { "m2_easy": ["m2_hard"], "m2_hard": ["m2_easy"] }
        }
      }
    },
    "module": {
      "type": "object",
      "required": ["tasks"],
      "additionalProperties": false,
      "properties": {
        "time_sec": { "type": "integer", "minimum": 30 },
        "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "line": {
      "type": "object",
      "required": ["speaker", "voice", "text"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string" },
        "voice": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "mcq": {
      "type": "object",
      "required": ["id", "prompt", "options", "answer", "skill", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "options": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
        "answer": { "type": "integer", "minimum": 0 },
        "skill": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_.]+$" },
        "explanation": { "type": "string" }
      }
    },
    "text": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "genre": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "type": {
          "enum": ["complete_the_words", "daily_life", "academic_passage", "choose_response", "conversation",
                   "announcement", "academic_talk", "build_sentence", "email", "academic_discussion",
                   "listen_and_repeat", "interview"]
        },
        "time_sec": { "type": "integer", "minimum": 10 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "complete_the_words" } } },
          "then": { "required": ["text"], "properties": { "title": { "type": "string" },
            "text": { "type": "string", "pattern": "\\[[A-Za-z'-]+\\]" } } } },
        { "if": { "properties": { "type": { "enum": ["daily_life", "academic_passage"] } } },
          "then": { "required": ["text", "questions"], "properties": { "text": { "$ref": "#/$defs/text" },
            "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mcq" } } } } },
        { "if": { "properties": { "type": { "enum": ["choose_response", "conversation", "announcement", "academic_talk"] } } },
          "then": { "required": ["audio", "questions"], "properties": { "context": { "type": "string" },
            "audio": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
            "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mcq" } } } } },
        { "if": { "properties": { "type": { "const": "build_sentence" } } },
          "then": { "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["id", "prompt", "chunks", "answer", "skill"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "prompt": { "type": "string" },
              "start": { "type": "string" },
              "end": { "type": "string" },
              "chunks": { "type": "array", "minItems": 3, "items": { "type": "string" } },
              "answer": { "type": "array", "minItems": 3, "items": { "type": "string" } },
              "skill": { "type": "string" },
              "explanation": { "type": "string" } } } } } } },
        { "if": { "properties": { "type": { "const": "email" } } },
          "then": { "required": ["scenario", "to", "subject", "bullets"], "properties": {
            "scenario": { "type": "string" }, "to": { "type": "string" }, "subject": { "type": "string" },
            "bullets": { "type": "array", "minItems": 2, "items": { "type": "string" } } } } },
        { "if": { "properties": { "type": { "const": "academic_discussion" } } },
          "then": { "required": ["course", "professor", "students"], "properties": {
            "course": { "type": "string" },
            "professor": { "type": "object", "required": ["name", "post"] },
            "students": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["name", "post"] } } } } },
        { "if": { "properties": { "type": { "const": "listen_and_repeat" } } },
          "then": { "required": ["setting", "items"], "properties": { "setting": { "type": "string" },
            "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "text", "voice", "response_sec"],
              "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "voice": { "type": "string" },
                "response_sec": { "type": "integer", "minimum": 4 } } } } } } },
        { "if": { "properties": { "type": { "const": "interview" } } },
          "then": { "required": ["topic", "intro", "questions", "answer_sec"], "properties": {
            "topic": { "type": "string" }, "intro": { "type": "string" }, "answer_sec": { "type": "integer" },
            "voice": { "type": "string" },
            "questions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "text"] } } } } }
      ]
    }
  }
}
